{
  "info": {
    "name": "ALFA — API умного кредитного кабинета",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "clientId", "value": "demo_cafe" },
    { "key": "applicationId", "value": "1" }
  ],
  "item": [
    {
      "name": "Клиенты",
      "item": [
        { "name": "Список клиентов", "request": { "method": "GET", "url": "{{baseUrl}}/clients" } },
        { "name": "Текущий клиент", "request": { "method": "GET", "header": [{ "key": "X-Client-Id", "value": "{{clientId}}" }], "url": "{{baseUrl}}/me" } }
      ]
    },
    {
      "name": "Кредитный сценарий",
      "item": [
        { "name": "Подобрать продукты", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"client_id\":\"{{clientId}}\",\"need\":{\"purpose\":\"working_capital\",\"amount\":1000000,\"term_months\":24},\"top_k\":3}" }, "url": "{{baseUrl}}/ranking/recommend" } },
        { "name": "Список заявок", "request": { "method": "GET", "header": [{ "key": "X-Client-Id", "value": "{{clientId}}" }], "url": "{{baseUrl}}/applications" } },
        { "name": "Детали заявки", "request": { "method": "GET", "header": [{ "key": "X-Client-Id", "value": "{{clientId}}" }], "url": "{{baseUrl}}/applications/{{applicationId}}" } }
      ]
    },
    {
      "name": "ИИ-помощник",
      "item": [
        { "name": "Диалог с ИИ-помощником", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"client_id\":\"{{clientId}}\",\"thread_id\":\"postman-demo\",\"message\":\"Какой риск у моей компании?\"}" }, "url": "{{baseUrl}}/chat" } }
      ]
    }
  ]
}
