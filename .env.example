# Local Python defaults. Docker Compose overrides service-to-service addresses.
DATABASE_URL=postgresql://alfa:alfa@localhost:5432/alfa
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=alfa_knowledge
EXTERNAL_API_URL=http://localhost:8100

# Ollama runs on the host machine, outside Docker.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=kamekichi128/qwen3-4b-instruct-2507
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# LLM adapter. Default uses native Ollama. To use any OpenAI-compatible
# open-weight endpoint set LLM_PROVIDER=openai_compatible and its /v1 URL.
LLM_PROVIDER=ollama
LLM_MODEL=kamekichi128/qwen3-4b-instruct-2507
LLM_BASE_URL=http://localhost:11434/v1
DOCKER_LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_CONTEXT_SIZE=8192

# Uploaded application documents.
UPLOAD_DIR=data/uploads

# External-source client settings.
EXTERNAL_TIMEOUT=2
EXTERNAL_RETRIES=2
